# Required
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Database
DATABASE_PATH=./data/flightgram.db

# Scheduler (cron expressions)
PRICE_CHECK_CRON=*/30 * * * *
WEEKLY_DIGEST_CRON=0 10 * * 0

# Currency
DEFAULT_CURRENCY=USD

# fli CLI configuration
# Install fli: pipx install flights
# See: https://github.com/punitarani/fli
FLI_PATH=fli
FLI_TIMEOUT_MS=60000
